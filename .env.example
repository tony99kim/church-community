# ==============================
# Spring Boot 백엔드 환경변수
# ==============================

# DB (Supabase에서 복사)
DATABASE_URL=jdbc:postgresql://db.xxxx.supabase.co:5432/postgres?user=postgres&password=YOUR_PASSWORD

# Redis (Upstash에서 복사)
REDIS_HOST=your-redis-endpoint.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=your-upstash-redis-password

# JWT (256비트 이상 랜덤 문자열)
JWT_SECRET=replace-this-with-a-very-long-random-secret-key-at-least-256-bits

# 프론트엔드 URL (Vercel 배포 후 입력)
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app

# 소셜 로그인 후 돌아갈 프론트 주소
OAUTH2_REDIRECT_URL=https://your-app.vercel.app/auth/callback

# ==============================
# Next.js 프론트 환경변수 (사용자 사이트 + /admin)
# ==============================
# 백엔드 주소. 브라우저 요청은 next.config.ts rewrites 로 같은 도메인을 거쳐 전달됨
NEXT_PUBLIC_API_URL=https://churchhub-backend.fly.dev
